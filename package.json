{
  "name": "ifcdc-barbers-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "kill-port 5050 || exit 0",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:api": "nodemon server.js",
    "dev:client": "npm run dev --prefix client -- --host",
    "dev:all": "concurrently -n api,web -c blue,green \"nodemon server.js\" \"npm run dev --prefix client -- --host\"",
    "dev:full": "npm run dev:all",
    "tunnel": "ngrok http 5050",
    "test:resend": "node scripts/test-resend.cjs",
    "test:paypal": "node scripts/verify-paypal-oauth.cjs",
    "set-super-admin-password": "node scripts/setSuperAdminPassword.mjs"
  },
  "dependencies": {
    "@paypal/checkout-server-sdk": "^1.0.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.20.0",
    "resend": "^6.10.0",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.9"
  }
}
