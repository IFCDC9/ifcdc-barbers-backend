# Copy to `.env` in this folder (same directory as server.js) and fill in from https://console.twilio.com
# Phone numbers must be E.164 (e.g. +15551234567).

TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=your_twilio_number

# --- Email (Resend only — https://resend.com) ---
# Set RESEND_API_KEY in project root `.env` (next to server.js) and/or `backend/.env` (merged by server.js).
#
# RESEND_API_KEY=re_xxxxxxxx
# Sender for booking + transactional mail (required for customer inboxes after domain verification):
# RESEND_FROM="IFCDC Barbers <bookings@yourdomain.com>"
# Verify the domain at https://resend.com/domains then use an address on that domain.
# Optional: staff copy of paid bookings — BOOKING_ADMIN_EMAIL=owner@example.com
# Optional: contact form inbox (full platform) — CONTACT_INBOX_EMAIL=service@ifcdc.org
