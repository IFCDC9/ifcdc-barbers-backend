PORT=5050

# --- Twilio (SMS / voice) — load from backend/.env (see repo root loadBackendEnv.mjs + server.js) ---
# SMS (voice booking confirmations): Messaging Service ONLY — set TWILIO_MESSAGING_SERVICE_SID (MG…).
# In Twilio Console → Messaging Service → Integration: Status Callback URL = https://YOUR_PUBLIC_HOST/api/sms/status
# Carrier debugging: send to another handset (E.164) to rule out self-send / filtering on your own line.
# TWILIO_SMS_OVERRIDE_TO=+15551234567
# TEMPORARY — bypass Messaging Service (isolates pool vs direct routing). Uses TWILIO_PHONE_NUMBER as from.
# TWILIO_SMS_FORCE_DIRECT=1
# TWILIO_SMS_DIRECT_TEST_BODY=DIRECT TEST IFCDC
# Twilio Console → Messaging Service → Sender Pool: keep only the long code(s) you intend (e.g. one +1) for predictable tests.
# After send, we poll Twilio until status is sent/delivered (or timeout). Tune if needed:
# SMS_DELIVERY_POLL_MAX_MS=35000
# SMS_DELIVERY_POLL_INTERVAL_MS=1500
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# If US carriers return 30034 (A2P 10DLC unregistered long code), complete Trust Hub brand + campaign for your +1 number,
# OR set a Twilio-verified toll-free E.164 here — we will resend failed US traffic once via this sender.
# TWILIO_SMS_FALLBACK_FROM=+18005551234
# TWILIO_SMS_FALLBACK_ON_30034=1
# Outbound voice calls (POST /api/call) — optional; not used for SMS.
TWILIO_PHONE_NUMBER=+13313168167

# Optional if not using repo root ../.env:
# PAYPAL_CLIENT_ID=your_sandbox_or_live_client_id
# PAYPAL_CLIENT_SECRET=secret_for_that_same_app
# PAYPAL_ENV=sandbox

# --- Resend (booking confirmation email) ---
# https://resend.com — API key from dashboard
RESEND_API_KEY=re_your_key_here
# Required for sending to real customer addresses: verify your domain in Resend, then set:
# RESEND_FROM="IFCDC Barbers <bookings@yourdomain.com>"
# Without RESEND_FROM, Resend may reject mail to addresses outside your test setup.
