# Dev: leave VITE_API_BASE unset/empty so requests stay same-origin and Vite proxies /api → :5050 (see vite.config.js).
# Do NOT set to http://localhost:5050 in dev — that bypasses the proxy and often causes "Load failed" / CORS issues.
# Set only for advanced cases (e.g. API on another host): VITE_API_BASE=https://api.example.com

# MUST equal root .env PAYPAL_CLIENT_ID (same app as PAYPAL_CLIENT_SECRET / PAYPAL_SECRET). Vite reads only this file.
# https://developer.paypal.com/dashboard/applications/sandbox
VITE_PAYPAL_CLIENT_ID=AUibwZAqgS6kZ_4Sk8g9fRROoj8zY5XxgFW-YFq4lWHz4ARQNT5ElehZQUl3SY3slr-5VTLI2HazUMrb
VITE_PAYPAL_ENVIRONMENT=production
VITE_BOOKING_PRICE=25
VITE_BOOKING_DEPOSIT=10

# Optional: shown in AURA chat header (must match server AURA_PHONE_NUMBER for /api/config).
VITE_AURA_PHONE_NUMBER=+13313168167

# E.164 business line for client-only flows (e.g. PayPal booking confirm). Should match root BUSINESS_PHONE.
VITE_BUSINESS_PHONE=+13313168167

# LAN API origin for mobile testing (must be reachable from your phone on Wi‑Fi).
VITE_API_URL=http://192.168.1.135:5050
